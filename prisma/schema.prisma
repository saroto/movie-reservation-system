// Cinema reservation system — v2
//
// Naming: singular table names throughout, except `users`
// (USER is a reserved word in Postgres).
//
// Everything Prisma cannot express — the GiST exclusion constraint, the
// partial unique index, the money/hold CHECKs and the updated_at triggers —
// lives in `prisma/post-generation.sql`. Apply it after the migration or the
// integrity model is incomplete.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
//
// Modelled as native Postgres enum types rather than varchar + CHECK.
// Same guarantee, and the client gets the union type for free.
// ─────────────────────────────────────────────

enum Role {
  user
  admin
}

enum ShowtimeStatus {
  scheduled
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  email        String   @unique @db.VarChar(255)
  /// text, not varchar(60) — argon2id hashes are ~100 chars
  passwordHash String   @map("password_hash")
  username     String?  @unique @db.VarChar(50)
  phoneNumber  String?  @map("phone_number") @db.VarChar(20)
  role         Role     @default(user)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  refreshTokens RefreshToken[]
  reservations  Reservation[]

  @@map("users")
}

model RefreshToken {
  tokenId   Int       @id @default(autoincrement()) @map("token_id")
  userId    Int       @map("user_id")
  /// sha-256 hex
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  isRevoked Boolean   @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt]) // cleanup job scans expired tokens
  @@map("refresh_token")
}

// ─────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────

model Genre {
  genreId     Int     @id @default(autoincrement()) @map("genre_id")
  genreName   String  @unique @map("genre_name") @db.VarChar(50)
  description String?

  movies MovieGenre[]

  @@map("genre")
}

model Movie {
  movieId      Int      @id @default(autoincrement()) @map("movie_id")
  title        String   @db.VarChar(255)
  posterImgUrl String?  @map("poster_img_url") @db.VarChar(500)
  description  String?
  /// minutes
  duration     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  genres    MovieGenre[]
  showtimes Showtime[]

  @@map("movie")
}

model MovieGenre {
  movieId Int @map("movie_id")
  genreId Int @map("genre_id")

  movie Movie @relation(fields: [movieId], references: [movieId], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [genreId], onDelete: Restrict)

  @@id([movieId, genreId])
  @@index([genreId]) // browse movies by genre
  @@map("movie_genre")
}

// ─────────────────────────────────────────────
// VENUE
// ─────────────────────────────────────────────

model Cinema {
  cinemaId   Int      @id @default(autoincrement()) @map("cinema_id")
  cinemaName String   @map("cinema_name") @db.VarChar(100)
  address    String?
  city       String?  @db.VarChar(100)
  timezone   String   @default("UTC") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  halls Hall[]

  @@map("cinema")
}

model Hall {
  hallId   Int    @id @default(autoincrement()) @map("hall_id")
  cinemaId Int    @map("cinema_id")
  hallName String @map("hall_name") @db.VarChar(50)

  cinema    Cinema     @relation(fields: [cinemaId], references: [cinemaId], onDelete: Restrict)
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, hallName]) // "Hall 1" can exist at every branch
  @@map("hall")
}

model SeatType {
  seatTypeId    Int     @id @default(autoincrement()) @map("seat_type_id")
  /// standard, vip, couple
  typeName      String  @unique @map("type_name") @db.VarChar(30)
  /// ADDED to showtime.basePrice
  priceModifier Decimal @default(0) @map("price_modifier") @db.Decimal(10, 2)

  seats Seat[]

  @@map("seat_type")
}

model Seat {
  seatId     Int     @id @default(autoincrement()) @map("seat_id")
  hallId     Int     @map("hall_id")
  seatTypeId Int     @map("seat_type_id")
  rowLetter  String  @map("row_letter") @db.VarChar(2)
  seatNumber Int     @map("seat_number")
  /// false = broken / removed chair
  isActive   Boolean @default(true) @map("is_active")

  hall             Hall              @relation(fields: [hallId], references: [hallId], onDelete: Restrict)
  seatType         SeatType          @relation(fields: [seatTypeId], references: [seatTypeId], onDelete: Restrict)
  reservationSeats ReservationSeat[]

  @@unique([hallId, rowLetter, seatNumber])
  @@unique([seatId, hallId], map: "uq_seat_hall") // FK target — see ReservationSeat
  @@map("seat")
}

model Showtime {
  showtimeId Int            @id @default(autoincrement()) @map("showtime_id")
  hallId     Int            @map("hall_id")
  movieId    Int            @map("movie_id")
  startTime  DateTime       @map("start_time") @db.Timestamptz()
  /// stored, not derived: allows cleaning/trailer buffer
  endTime    DateTime       @map("end_time") @db.Timestamptz()
  /// final price = basePrice + seatType.priceModifier
  basePrice  Decimal        @map("base_price") @db.Decimal(10, 2)
  status     ShowtimeStatus @default(scheduled)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  hall             Hall              @relation(fields: [hallId], references: [hallId], onDelete: Restrict)
  movie            Movie             @relation(fields: [movieId], references: [movieId], onDelete: Restrict)
  reservations     Reservation[]
  reservationSeats ReservationSeat[]

  @@unique([showtimeId, hallId], map: "uq_showtime_hall") // FK target
  @@index([hallId, startTime])
  @@index([movieId])
  @@index([startTime]) // "showtimes for a specific date"
  @@map("showtime")
}

// ─────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────

model Reservation {
  reservationId Int               @id @default(autoincrement()) @map("reservation_id")
  userId        Int               @map("user_id")
  showtimeId    Int               @map("showtime_id")
  /// invoice snapshot; intentionally not derived
  totalPrice    Decimal           @map("total_price") @db.Decimal(10, 2)
  status        ReservationStatus @default(pending)
  /// set on pending; cleanup job expires the hold
  holdExpiresAt DateTime?         @map("hold_expires_at") @db.Timestamptz()
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user             User              @relation(fields: [userId], references: [userId], onDelete: Restrict)
  showtime         Showtime          @relation(fields: [showtimeId], references: [showtimeId], onDelete: Restrict)
  reservationSeats ReservationSeat[]
  payments         Payment[]

  @@unique([reservationId, showtimeId], map: "uq_reservation_showtime") // FK target
  @@index([userId])
  @@index([showtimeId])
  @@index([status, holdExpiresAt]) // cleanup job finds stale holds
  @@map("reservation")
}

/// hallId is denormalized on purpose. It is the join key that forces
/// the seat and the showtime to belong to the same hall.
///
/// Cancellation sets isActive = false. It does NOT delete the row —
/// the partial unique index (post-generation.sql) frees the seat while
/// the ticket history, price paid, and refund trail all survive.
model ReservationSeat {
  ticketId        Int     @id @default(autoincrement()) @map("ticket_id")
  reservationId   Int     @map("reservation_id")
  /// must match reservation.showtimeId — enforced by the composite FK
  showtimeId      Int     @map("showtime_id")
  seatId          Int     @map("seat_id")
  /// must match BOTH seat.hallId and showtime.hallId
  hallId          Int     @map("hall_id")
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)
  /// false = cancelled, seat released, row kept
  isActive        Boolean @default(true) @map("is_active")

  // The three composite FKs that carry the whole integrity model.
  reservation Reservation @relation(fields: [reservationId, showtimeId], references: [reservationId, showtimeId], onDelete: Cascade, onUpdate: NoAction)
  seat        Seat        @relation(fields: [seatId, hallId], references: [seatId, hallId], onDelete: Restrict, onUpdate: NoAction)
  showtime    Showtime    @relation(fields: [showtimeId, hallId], references: [showtimeId, hallId], onDelete: Restrict, onUpdate: NoAction)

  @@index([reservationId])
  /// NOT unique here — a partial unique index on (showtime_id, seat_id)
  /// WHERE is_active lives in post-generation.sql.
  @@index([showtimeId, seatId])
  @@map("reservation_seat")
}

model Payment {
  paymentId     Int           @id @default(autoincrement()) @map("payment_id")
  reservationId Int           @map("reservation_id")
  amount        Decimal       @db.Money()
  currency      String        @default("USD") @db.Char(3)
  status        PaymentStatus @default(pending)
  /// stripe, aba, wing, cash
  provider      String        @db.VarChar(50)
  providerTxnId String?       @unique @map("provider_txn_id") @db.VarChar(255)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  reservation Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Restrict)

  @@index([reservationId])
  @@map("payment")
}
